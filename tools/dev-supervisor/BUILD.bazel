load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "dev-supervisor_lib",
    srcs = ["main.go"],
    importpath = "github.com/antonve/dev-cli-playground/tools/dev-supervisor",
    visibility = ["//visibility:private"],
)

go_binary(
