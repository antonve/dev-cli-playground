module(name = "dev_cli_playground", version = "0.1.0")

bazel_dep(name = "gazelle", version = "0.52.2")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.2.0")
bazel_dep(name = "rules_go", version = "0.62.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.2.0")

cc_toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(cc_toolchains, "zig_sdk")
register_toolchains("@zig_sdk//toolchain/...", "@zig_sdk//libc_aware/toolchain/...")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(name = "playground_go_sdk", go_mod = "//:go.mod")
use_repo(go_sdk, "playground_go_sdk")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_static_debian13_nonroot",
    digest = "sha256:f2ea2709ac8db56323cbd7d014277f32cb572d9ea124b0076f7aafe5980678fe",
    image = "gcr.io/distroless/static-debian13",
    platforms = ["linux/amd64"],
)
use_repo(oci, "distroless_static_debian13_nonroot", "distroless_static_debian13_nonroot_linux_amd64")
