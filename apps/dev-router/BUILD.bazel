load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//build:go_image.bzl", "go_image")

go_library(
    name = "dev-router_lib",
    srcs = ["main.go"],
    importpath = "github.com/antonve/dev-cli-playground/apps/dev-router",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "dev-router",
    embed = [":dev-router_lib"],
    pure = "on",
    static = "on",
    visibility = ["//visibility:public"],
)

go_image(
    name = "image",
    binary = ":dev-router",
    binary_name = "dev-router",
    repository = "registry.dev.lab/dev-cli-playground/dev-router",
)

go_test(
    name = "dev-router_test",
    srcs = ["main_test.go"],
    embed = [":dev-router_lib"],
)
