load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//build:dev_deployable.bzl", "dev_deployable")
load("//build:go_image.bzl", "go_image")

go_library(
    name = "hello-api_lib",
    srcs = ["main.go"],
    importpath = "github.com/antonve/dev-cli-playground/apps/hello-api",
    visibility = ["//visibility:private"],
    deps = ["//internal/identity"],
)

go_binary(
    name = "hello-api",
    embed = [":hello-api_lib"],
    pure = "on",
    static = "on",
    visibility = ["//visibility:public"],
)

go_image(
    name = "image",
    binary = ":hello-api",
    binary_name = "hello-api",
)

dev_deployable(
    name = "dev",
    binary_path = "/app/hello-api",
    build_target = "//apps/hello-api:hello-api",
    container_path = "/app/hello-api",
    image_name = "hello-api",
    image_target = "//apps/hello-api:image",
    kind = "backend",
    port = 8081,
    public_path = "/api",
    push_target = "//apps/hello-api:image_push",
    service_name = "hello-api",
    source_roots = [
        "apps/hello-api",
        "internal/identity",
    ],
    visibility = ["//visibility:public"],
    deps = [":hello-api"],
)

go_test(
    name = "hello-api_test",
    srcs = ["main_test.go"],
    embed = [":hello-api_lib"],
)
