load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//apps/hello-web:typescript/package_json.bzl", tsc = "bin")
load("@npm//apps/hello-web:vite/package_json.bzl", vite = "bin")
load("//build:dev_deployable.bzl", "dev_deployable")
load("//build:frontend_image.bzl", "frontend_image")

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "sources",
    srcs = glob([
        "src/**",
        "index.html",
        "package.json",
        "server.mjs",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts",
    ]),
    visibility = ["//visibility:public"],
)

tsc.tsc_test(
    name = "typecheck",
    args = ["--noEmit"],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":sources",
    ],
)

vite.vite(
    name = "bundle",
    args = ["build"],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":sources",
    ],
    out_dirs = ["dist"],
)

frontend_image(
    name = "image",
    bundle = ":bundle",
    srcs = [
        "//:package.json",
        "//:pnpm-lock.yaml",
        "//:pnpm-workspace.yaml",
        ":sources",
    ],
)

dev_deployable(
    name = "dev",
    build_target = "//apps/hello-web:image",
    dev_command = [
        "/bin/sh",
        "-lc",
        "corepack pnpm install --frozen-lockfile && corepack pnpm --filter @dev-cli/hello-web dev",
    ],
    image_name = "hello-web",
    image_target = "//apps/hello-web:image",
    kind = "frontend",
    port = 8080,
    public_path = "/",
    push_target = "//apps/hello-web:image_push",
    service_name = "hello-web",
    source_roots = [
        "apps/hello-web",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
    ],
    sync_paths = ["apps/hello-web"],
    visibility = ["//visibility:public"],
    deps = [
        ":image",
        ":sources",
        "//:package.json",
        "//:pnpm-lock.yaml",
        "//:pnpm-workspace.yaml",
    ],
)
